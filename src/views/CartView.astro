---
import Base from '~/layouts/Base.astro';
import '~/styles/shop.css';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import CartPanel from '~/components/CartPanel.astro';
import type { Locale } from '~/config/site';
import { useT } from '~/i18n/ui';
import { href, routes } from '~/i18n/routes';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
---
<Base locale={locale} path={routes.cart} title={`${t('cart.title')} | ${t('meta.siteName')}`} description={t('cart.note')} noindex>
  <div class="container section--tight">
    <Breadcrumbs items={[{ label: t('common.home'), href: href(locale) }, { label: t('cart.title') }]} locale={locale} />
    <h1>{t('cart.title')}</h1>
    <div class="cart-page">
      <CartPanel locale={locale} variant="page" />
    </div>
  </div>
</Base>
