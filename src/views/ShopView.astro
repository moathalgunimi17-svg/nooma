---
/**
 * Product listing. Every product is server-rendered (works without JS);
 * the filter script narrows, sorts and syncs the URL. Filters are built
 * from the catalogue — a facet with nothing to choose between is not shown.
 */
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import '~/styles/shop.css';
import ProductCard from '~/components/ProductCard.astro';
import Icon from '~/components/Icon.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { type Locale } from '~/config/site';
import { useT, countLabel } from '~/i18n/ui';
import { href, routes } from '~/i18n/routes';
import { products, sizes } from '~/data/catalog';
import { art, artAlt, liveCategories, getCategory } from '~/lib/art';
import catCurled from '~/assets/brand/cat-curled.svg';

interface Props { locale: Locale; categoryId?: string }
const { locale, categoryId } = Astro.props;
const t = useT(locale);
const cats = liveCategories();
const cat = categoryId ? getCategory(categoryId) : undefined;
const list = cat ? products.filter((p) => p.categoryId === cat.id) : products;

// Facets from real data only.
const sizeFacet = sizes.filter((s) => list.some((p) => p.sizeIds.includes(s.id)));
const colourMap = new Map<string, { id: string; name: string; swatch: string }>();
for (const p of list) for (const c of p.colourways) if (!colourMap.has(c.id)) colourMap.set(c.id, { id: c.id, name: c.name[locale], swatch: c.swatch });
const colourFacet = [...colourMap.values()];
const priced = list.filter((p) => p.price !== null);
const canSortByPrice = new Set(priced.map((p) => p.price)).size > 1;

const path = cat ? routes.collection(cat.slug) : routes.shop;
const title = cat ? `${cat.name[locale]} | ${t('meta.siteName')}` : `${t('shop.title')} | ${t('meta.siteName')}`;
const desc = cat ? `${cat.blurb[locale]} — ${t('shop.desc')}` : t('shop.desc');
const crumbs = [
  { label: t('common.home'), href: href(locale) },
  ...(cat ? [{ label: t('nav.allProducts'), href: href(locale, routes.shop) }] : []),
  { label: cat ? cat.name[locale] : t('shop.title') },
];
---
<Base locale={locale} path={path} title={title} description={desc}>
  <section class="shop-hero" style={cat ? `--tint: var(--tint-${cat.tint})` : undefined}>
    <div class="container shop-hero__inner">
      <div>
        <Breadcrumbs items={crumbs} locale={locale} />
        <h1>{cat ? cat.name[locale] : t('shop.title')}</h1>
        <p class="muted">{cat ? cat.blurb[locale] : t('shop.desc')}</p>
      </div>
      {cat && (
        <Image class="shop-hero__art" src={art[cat.art]} alt={artAlt[cat.art][locale]} width={200} densities={[1, 2]} loading="eager" />
      )}
    </div>
  </section>

  <div class="container shop" data-shop data-fixed-category={cat?.id ?? ''}>
    <div class="shop__bar">
      <label class="shop__search">
        <Icon name="search" />
        <span class="visually-hidden">{t('shop.searchLabel')}</span>
        <input type="search" placeholder={t('search.placeholder')} data-f-q autocomplete="off" />
      </label>
      <p class="shop__count" data-f-count aria-live="polite">{countLabel(locale, list.length)}</p>
      <button class="btn btn--ghost btn--sm shop__filter-btn" type="button" data-open="filters-sheet" aria-haspopup="dialog">
        <Icon name="filter" /> {t('shop.showFilters')}
      </button>
    </div>
    <div class="shop__active" data-f-active hidden></div>

    <div class="shop__layout">
      <dialog class="shop__filters sheet sheet--start" id="filters-sheet" aria-label={t('shop.filters')}>
        <div class="sheet__head shop__filters-head">
          <h2>{t('shop.filters')}</h2>
          <button class="icon-btn" type="button" data-close><Icon name="close" /><span class="visually-hidden">{t('a11y.close')}</span></button>
        </div>
        <form class="sheet__body" data-f-form>
          {!cat && cats.length > 1 && (
            <fieldset class="opt-group">
              <legend>{t('shop.collection')}</legend>
              <div class="sizes">
                <label class="size-chip"><input type="radio" name="c" value="" checked /><span>{t('shop.allCollections')}</span></label>
                {cats.map((c) => (
                  <label class="size-chip"><input type="radio" name="c" value={c.id} /><span>{c.name[locale]}</span></label>
                ))}
              </div>
            </fieldset>
          )}
          {sizeFacet.length > 1 && (
            <fieldset class="opt-group">
              <legend>{t('shop.size')}</legend>
              <div class="sizes">
                {sizeFacet.map((s) => (
                  <label class="size-chip"><input type="checkbox" name="size" value={s.id} data-label={s.label[locale]} /><span>{s.label[locale]}</span></label>
                ))}
              </div>
            </fieldset>
          )}
          {colourFacet.length > 1 && (
            <fieldset class="opt-group">
              <legend>{t('shop.colour')}</legend>
              <div class="swatches">
                {colourFacet.map((c) => (
                  <label class="swatch" style={`--sw: ${c.swatch}`}><input type="checkbox" name="colour" value={c.id} data-label={c.name} /><span>{c.name}</span></label>
                ))}
              </div>
            </fieldset>
          )}
          <div class="field">
            <label for="f-sort">{t('shop.sort')}</label>
            <select class="select" id="f-sort" name="sort">
              <option value="featured">{t('shop.sort.featured')}</option>
              {canSortByPrice && <option value="priceAsc">{t('shop.sort.priceAsc')}</option>}
              {canSortByPrice && <option value="priceDesc">{t('shop.sort.priceDesc')}</option>}
              <option value="name">{t('shop.sort.name')}</option>
            </select>
          </div>
          <div class="shop__filters-actions">
            <button class="btn btn--ghost" type="reset" data-f-clear>{t('shop.clear')}</button>
            <button class="btn shop__apply" type="button" data-close>{t('shop.applyFilters')}</button>
          </div>
        </form>
      </dialog>

      <div class="shop__results">
        <div class="pgrid" data-f-grid>
          {list.map((p, i) => <ProductCard product={p} locale={locale} index={i} eager={i < 2} />)}
        </div>
        <div class="shop__empty" data-f-empty hidden>
          <img src={catCurled.src} width="160" height="148" alt="" loading="lazy" />
          <h2>{t('shop.emptyTitle')}</h2>
          <p class="muted">{t('shop.emptyText')}</p>
          <button class="btn" type="button" data-f-clear>{t('shop.clear')}</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import '~/scripts/shop';
</script>
