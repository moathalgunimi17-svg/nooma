---
/**
 * Product card shaped like Nooma's hang-tags: punched hole, string,
 * a tinted panel holding the artwork. Swings gently on hover.
 */
import { Image } from 'astro:assets';
import type { Locale } from '~/config/site';
import type { Product } from '~/data/types';
import { useT } from '~/i18n/ui';
import { href, routes } from '~/i18n/routes';
import { coverImage, getCategory, picSrc } from '~/lib/art';
import { formatPrice } from '~/lib/format';
import { priceRange } from '~/lib/order';
import Icon from './Icon.astro';

interface Props { product: Product; locale: Locale; index?: number; eager?: boolean }
const { product: p, locale, index = 0, eager = false } = Astro.props;
const t = useT(locale);
const cat = getCategory(p.categoryId);
const first = p.colourways[0]!;
const url = href(locale, routes.product(p.slug));
const tint = cat?.tint ?? 'lavender';
const cover = coverImage(p, first);
const range = priceRange(p);
---
<article
  class="pcard"
  data-product-card
  data-id={p.id}
  data-category={p.categoryId}
  data-sizes={p.sizeIds.join(' ')}
  data-colours={p.colourways.map((c) => c.id).join(' ')}
  data-price={range?.min ?? ''}
  data-featured={p.featured ? '1' : '0'}
  data-order={index}
  data-name={p.name[locale]}
  style={`--tint: var(--tint-${tint}); --i: ${index % 4}`}
  data-reveal
>
  <a class="pcard__media" href={url} tabindex="-1" aria-hidden="true">
    <span class="pcard__hole"></span>
    {cover ? (
      <Image
        class="pcard__img"
        {...picSrc(cover)}
        alt=""
        widths={[240, 360, 480]}
        sizes="(max-width: 640px) 46vw, (max-width: 1100px) 30vw, 260px"
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <span class="photo-slot pcard__slot" dir="ltr">{p.code}</span>
    )}
  </a>
  <div class="pcard__body">
    {p.sample && <span class="chip chip--sample pcard__sample">{t('product.sample')}</span>}
    <h3 class="pcard__name"><a href={url}>{p.name[locale]}</a></h3>
    {p.code && <p class="pcard__code">{p.code}</p>}
    {p.summary[locale] && <p class="pcard__summary">{p.summary[locale]}</p>}
    <div class="pcard__foot">
      <p class="pcard__price">
        {range === null ? (
          <span class="muted">{t('product.priceTbc')}</span>
        ) : (
          <>
            {p.compareAtPrice && <s class="muted">{formatPrice(p.compareAtPrice, locale)}</s>}
            <span>{range.min === range.max ? formatPrice(range.min, locale) : t('product.from').replace('{price}', formatPrice(range.min, locale))}</span>
          </>
        )}
      </p>
      {p.colourways.length > 1 && (
        <ul role="list" class="pcard__swatches" aria-label={t('product.colour')}>
          {p.colourways.map((c) => (
            <li style={`--sw: ${c.swatch}`} title={c.name[locale]}><span class="visually-hidden">{c.name[locale]}</span></li>
          ))}
        </ul>
      )}
    </div>
    <button class="btn btn--soft btn--sm pcard__add" type="button" data-quick-add={p.id} disabled={p.price === null}>
      <Icon name="bag" /> {t('product.quickAdd')}
    </button>
  </div>
</article>
