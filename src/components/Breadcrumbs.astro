---
import type { Locale } from '~/config/site';
import { useT } from '~/i18n/ui';
interface Props { items: { label: string; href?: string }[]; locale: Locale }
const { items, locale } = Astro.props;
const t = useT(locale);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.label,
    ...(it.href ? { item: new URL(it.href, Astro.site ?? 'https://nooma.om').href } : {}),
  })),
};
---
<nav class="crumbs" aria-label={t('a11y.breadcrumb')}>
  <ol role="list">
    {items.map((it, i) => (
      <li>
        {it.href ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
        {i < items.length - 1 && <span class="crumbs__sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
