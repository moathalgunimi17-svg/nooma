---
/** A tiny Nooma shopping bag: the real packaging's lavender stripes on ivory. */
---
<svg class="bag-icon" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="bag-body"><path d="M6.5 11h19l-1.4 15.2a2 2 0 0 1-2 1.8H9.9a2 2 0 0 1-2-1.8z" /></clipPath>
  </defs>
  <path class="bag-icon__body" d="M6.5 11h19l-1.4 15.2a2 2 0 0 1-2 1.8H9.9a2 2 0 0 1-2-1.8z" />
  <g clip-path="url(#bag-body)" class="bag-icon__stripes">
    <path d="M9 10c.6 6 -.6 12 .2 19M13.5 10c-.5 6 .6 12 -.2 19M18 10c.6 6-.5 12 .2 19M22.5 10c-.5 6 .5 12-.2 19" />
  </g>
  <path class="bag-icon__outline" d="M6.5 11h19l-1.4 15.2a2 2 0 0 1-2 1.8H9.9a2 2 0 0 1-2-1.8z" />
  <path class="bag-icon__handle" d="M11.5 13.5V9a4.5 4.5 0 0 1 9 0v4.5" />
</svg>
